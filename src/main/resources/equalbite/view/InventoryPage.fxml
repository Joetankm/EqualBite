<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" styleClass="backgroundColor" stylesheets="@stylesheet.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="equalbite.view.InventoryPageController">
   <children>
      <SplitPane id="inventoryBackground" layoutX="45.0" layoutY="63.0" prefHeight="400.0" prefWidth="600.0" styleClass="backgroundColor" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <items>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
               <children>
                  <Label styleClass="headerText" text="Inventory Tracker" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0" />
                  <TableView fx:id="inventoryTableView" layoutY="77.0" prefHeight="330.0" prefWidth="597.0" styleClass="inventoryTableColor" AnchorPane.bottomAnchor="-8.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="75.0">
                     <columns>
                        <TableColumn fx:id="itemCodeTableColumn" prefWidth="95.33337152004242" styleClass="inventoryTableColor" text="Item Code" />
                        <TableColumn fx:id="nameTableColumn" prefWidth="109.3333511352539" styleClass="inventoryTableColor" text="Name" />
                        <TableColumn fx:id="categoryTableColumn" prefWidth="131.33335876464844" styleClass="inventoryTableColor" text="Category" />
                        <TableColumn fx:id="stockTableColumn" prefWidth="86.6666259765625" styleClass="inventoryTableColor" text="Stock" />
                        <TableColumn fx:id="detailTableColumn" prefWidth="164.66671752929688" styleClass="inventoryTableColor" text="Detail" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <ButtonBar layoutX="233.0" layoutY="12.0" AnchorPane.rightAnchor="10.0">
                     <buttons>
                        <Button onAction="#handleNewItem" styleClass="distributionButton" text="_New Item" />
                        <Button onAction="#handleDelete" styleClass="distributionButton" text="_Delete Item" />
                        <Button onAction="#handleEdit" styleClass="distributionButton" text="_Edit Item" />
                        <Button mnemonicParsing="false" onAction="#handlePrintRecord" styleClass="distributionButton" text="Print Record" />
                     </buttons>
                  </ButtonBar>
                  <GridPane prefHeight="30.0" prefWidth="426.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="40.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="551.9999593098959" minWidth="10.0" prefWidth="546.6666463216146" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="206.0" minWidth="10.0" prefWidth="31.33335367838538" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <TextField fx:id="searchText" prefHeight="25.0" prefWidth="517.0" promptText="Search for Item Code, Name, or Category..." />
                        <Button defaultButton="true" mnemonicParsing="false" onAction="#handleSearch" GridPane.columnIndex="1">
                           <graphic>
                              <ImageView fx:id="searchImage" fitHeight="34.0" fitWidth="20.0" opacity="0.5" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/search icon.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                     </children>
                  </GridPane>
               </children>
            </AnchorPane>
        </items>
      </SplitPane>
   </children>
