                     <columns>
                        <TableColumn fx:id="usernameTableColumn" prefWidth="75.0" styleClass="recipientTableColor" text="Username" />
                        <TableColumn fx:id="nameTableColumn" prefWidth="75.0" styleClass="recipientTableColor" text="Name" />
                        <TableColumn fx:id="contactTableColumn" prefWidth="75.0" styleClass="recipientTableColor" text="Contact" />
                        <TableColumn fx:id="addressTableColumn" prefWidth="75.0" styleClass="recipientTableColor" text="Address" />
                        <TableColumn fx:id="householdSizeTableColumn" prefWidth="75.0" styleClass="recipientTableColor" text="Household Size" />
                        <TableColumn fx:id="elderlyCountTableColumn" prefWidth="75.0" styleClass="recipientTableColor" text="No. Elderly" />
                        <TableColumn fx:id="childrenCountTableColumn" prefWidth="75.0" styleClass="recipientTableColor" text="No. Children" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
