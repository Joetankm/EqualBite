                  <TableView fx:id="requestsTableView" layoutY="77.0" prefHeight="327.0" prefWidth="597.0" styleClass="distributionReqTableColor" AnchorPane.bottomAnchor="-5.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="75.0">
                     <columns>
                        <TableColumn fx:id="nameTableColumn" prefWidth="120.66668450832367" styleClass="distributionReqTableColor" text="Requester Name" />
                        <TableColumn fx:id="contactTableColumn" prefWidth="119.9999771118164" styleClass="distributionReqTableColor" text="Requester Contact" />
                        <TableColumn fx:id="recipientTableColumn" prefWidth="89.33329772949219" styleClass="distributionReqTableColor" text="Recipient" />
                        <TableColumn fx:id="itemCodeTableColumn" prefWidth="76.6666259765625" styleClass="distributionReqTableColor" text="Item Code" />
                        <TableColumn fx:id="quantityTableColumn" prefWidth="94.66668701171875" styleClass="distributionReqTableColor" text="Quantity" />
                        <TableColumn fx:id="dateTableColumn" prefWidth="109.33334350585938" styleClass="distributionReqTableColor" text="Date" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
